# Région AWS utilisée pour les appels Bedrock
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Credentials AWS (IAM ou session temporaire SSO/STS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=        # optionnel — uniquement pour les credentials temporaires STS/SSO

# Identifiant du modèle AWS Bedrock
MODEL_ID=us.anthropic.claude-sonnet-4-6
